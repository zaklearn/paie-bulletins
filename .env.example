# Copier ce fichier en .env (jamais versionné) puis adapter.

# Base SQLite (chemin relatif au dossier du projet ou absolu)
PAIE_DB_PATH=data/paie.db

# Répertoire des sauvegardes
PAIE_BACKUP_DIR=data/backups

# Hachage du mot de passe d'accès. Obligatoire, sauf dérogation PAIE_ALLOW_NO_AUTH=1 ci-dessous.
# Générer avec : python scripts/hash_password.py
PAIE_AUTH_PASSWORD_HASH=

# 1 = créer les données de démonstration fictives si la base est vide ; 0 en production.
PAIE_SEED_DEMO=1

# Dérogation : 1 = ouvrir l'application SANS mot de passe quand PAIE_AUTH_PASSWORD_HASH est vide.
# USAGE LOCAL UNIQUEMENT, sur votre poste. Ne jamais définir sur un hébergement accessible à distance.
# Sans cette ligne et sans mot de passe, l'application affiche « Configuration incomplète » et reste fermée.
PAIE_ALLOW_NO_AUTH=1
